# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Server Configuration
PORT=3000
NODE_ENV=development
DATABASE_LOG_QUERIES=false

# DigitalOcean Spaces (Storage)
DO_SPACES_ENDPOINT=https://atl1.digitaloceanspaces.com
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_REGION=atl1
DO_SPACES_ACCESS_KEY=your_access_key
DO_SPACES_SECRET_KEY=your_secret_key
DO_SPACES_URL=your_cdn_url
CDN_URL=your_cdn_domain

# Email Service - SMTP Configuration
TACTICKA_SMTP_HOST=your_smtp_host
TACTICKA_SMTP_PORT=465
TACTICKA_SMTP_USER=your_email
TACTICKA_SMTP_PASS=your_password
TACTICKA_SMTP_FROM=no-reply@example.com

# SendGrid Configuration
MAIL_SERVICE_ENABLED=true
MAIL_FROM_ADDRESS=no-reply@example.com
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=Your Company Name
SENDGRID_REPLY_TO=support@example.com

# Session Configuration
SESSION_COOKIE_NAME=sky_sid

# Stripe Configuration
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_SECRET_KEY=your_stripe_secret_key

# Frontend Configuration
FRONTEND_URL=http://localhost:3001

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id

# SINPE Configuration (Costa Rica)
SINPE_PHONE=8888-8888
SINPE_ACCOUNT_NAME=Skyplay Costa Rica

# CoinPal Configuration
COINPAL_CLIENT_ID=your_coinpal_client_id
COINPAL_SECRET_KEY=your_coinpal_secret_key

# ReCAPTCHA Configuration
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
